{
  "name": "@piwikpro/vue-piwik-pro",
  "private": false,
  "version": "2.0.0",
  "type": "module",
  "author": "Piwik Pro Integration Team <integrations@piwik.pro>",
  "license": "MIT",
  "description": "Piwik PRO tracking library for VueJS",
  "main": "dist/index.umd.js",
  "module": "dist/index.js",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "version": "node scripts/bakeInVersion.js && auto-changelog -p && git add CHANGELOG.md src/version.ts",
    "build": "node scripts/bakeInVersion.js && vue-tsc && vite build",
    "build:docs": "typedoc && concat-md --decrease-title-levels --start-title-level-at=2 docs_raw > README.md && node scripts/postProcessDocs.js",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue,.ts src",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "auto-changelog": "^2.6.0",
    "concat-md": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.20.1",
    "happy-dom": "^20.10.6",
    "prettier": "^3.2.4",
    "rollup-plugin-vue": "^6.0.0",
    "tslib": "^2.6.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  },
  "keywords": [
    "vue",
    "piwik-pro",
    "analytics",
    "plugin"
  ],
  "dependencies": {
    "@piwikpro/tracking-base-library": "^2.0.0"
  }
}
